{
  "name": "todos",
  "version": "1.0.0",
  "private": true,
  "description": "A small todo list web app: a Node HTTP server with a JSON file store and a vanilla TypeScript UI.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server/main.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server/main.ts",
    "test": "node --disable-warning=ExperimentalWarning --test 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/client/tsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
